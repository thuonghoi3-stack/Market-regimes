# Shared OAuth credentials for the Grok sandbox live-preview client.
# Obtain the value from the auth broker configuration; do not commit a real secret.
GROK_PREVIEW_CLIENT_SECRET=replace-with-preview-client-secret

# Optional per-deployment auth configuration. The platform can inject these.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# DATABASE_URL=
# VITE_AUTH_ENABLED=false
